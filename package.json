{
  "name": "torflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Data flow in the Tor network, as a static site built by GitHub Actions",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test pipeline/test/*.test.js",
    "data:update": "node pipeline/update.js",
    "data:backfill": "node pipeline/backfill.js",
    "data:publish": "node pipeline/publish.js",
    "data:countries": "node pipeline/build-countries.js"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "d3": "7.9.0",
    "leaflet": "1.9.4",
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "maxmind": "4.3.24",
    "vite": "5.4.11"
  }
}
